# VITE_* variables are embedded into the JS bundle at build time.
# Never put secrets here — only public, non-sensitive config.

# Entra ID app registration for the SPA (NOT the Function App registration)
VITE_AZURE_AD_TENANT_ID=your-tenant-id-here
VITE_AZURE_AD_CLIENT_ID=your-spa-client-id-here
VITE_AZURE_AD_API_SCOPE=api://your-api-client-id-here/user_impersonation

# Azure Speech Service region (e.g. eastus)
VITE_SPEECH_SERVICE_REGION=eastus
