# E2E Test Environment Configuration
# Copy this file to .env.test and fill in your test-specific values
#
# NOTE: Playwright will automatically load .env.development first,
# so you only need to specify test-specific overrides here.
# VITE_* variables (Azure AD config) come from .env.development

# Application URLs (optional overrides)
# TEST_BASE_URL=http://localhost:5173
# TEST_API_URL=http://localhost:7071

# Azure AD (Entra ID) Test User Credentials
# 
# The E2E auth setup supports TWO authentication modes:
#
# ┌─────────────────────────────────────────────────────────────────────┐
# │ MODE 1: MANUAL LOGIN (Recommended for Local Development)           │
# └─────────────────────────────────────────────────────────────────────┘
# Leave TEST_USER_EMAIL and TEST_USER_PASSWORD commented out.
# The setup will open a VISIBLE browser window where you can:
#   • Complete passkey/biometric authentication
#   • Use MFA, Windows Hello, or any other auth method
#   • Session is saved and reused for all subsequent test runs
#
# Usage:
#   1. Run: npm run test:e2e
#   2. Browser opens automatically
#   3. Complete your authentication (3 minute timeout)
#   4. Tests run automatically after login
#
# ┌─────────────────────────────────────────────────────────────────────┐
# │ MODE 2: AUTOMATED LOGIN (Required for CI/CD)                       │
# └─────────────────────────────────────────────────────────────────────┘
# Create a dedicated test user in Azure AD WITHOUT passkey/MFA:
#   1. Azure Portal → Azure Active Directory → Users → New user
#   2. Username: e2e-test@yourdomain.com
#   3. Password: Set a strong password (no passkey/MFA)
#   4. Grant appropriate roles/permissions
#   5. Uncomment and fill in credentials below:
#
# TEST_USER_EMAIL=e2e-test@yourdomain.com
# TEST_USER_PASSWORD=YourSecureTestPassword123!

# Test Data Configuration
TEST_CLIENT_ID_PREFIX=e2e-test-client
TEST_SESSION_CLEANUP_ENABLED=true

# Optional: Cosmos DB Configuration for test data cleanup
# If not provided, tests will use the app's default configuration
# COSMOS_ENDPOINT=https://localhost:8081
# COSMOS_KEY=your-emulator-key-here
# COSMOS_DATABASE=TheragrafTest

# Optional: Azure Speech Service (if testing audio recording)
# SPEECH_KEY=your-test-speech-key
# SPEECH_REGION=your-region

# CI/CD Specific Settings
# CI=true
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
