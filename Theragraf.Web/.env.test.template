# E2E Test Environment Configuration
# Copy this file to .env.test and fill in your test-specific values

# Application URLs
TEST_BASE_URL=http://localhost:5173
TEST_API_URL=http://localhost:7071

# Azure AD (Entra ID) Test User Credentials
# IMPORTANT: Use a dedicated test user account, NOT a production account
# Create a test user in your Azure AD tenant for E2E testing
TEST_USER_EMAIL=test-therapist@yourdomain.com
TEST_USER_PASSWORD=YourSecureTestPassword123!

# Azure AD Application Configuration
# These should match your app registration in Azure Portal
VITE_AZURE_CLIENT_ID=your-client-id-here
VITE_AZURE_TENANT_ID=your-tenant-id-here
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# Test Data Configuration
TEST_CLIENT_ID_PREFIX=e2e-test-client
TEST_SESSION_CLEANUP_ENABLED=true

# Optional: Cosmos DB Configuration for test data cleanup
# If not provided, tests will use the app's default configuration
# COSMOS_ENDPOINT=https://localhost:8081
# COSMOS_KEY=your-emulator-key-here
# COSMOS_DATABASE=TheragrafTest

# Optional: Azure Speech Service (if testing audio recording)
# SPEECH_KEY=your-test-speech-key
# SPEECH_REGION=your-region

# CI/CD Specific Settings
# CI=true
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
