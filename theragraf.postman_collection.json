{
  "info": {
    "name": "Theragraf - Documentation Pipeline",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7071"
    },
    {
      "key": "instanceId",
      "value": ""
    },
    {
      "key": "statusCode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Start Documentation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('instanceId', json.instanceId);",
              "pm.collectionVariables.set('statusQueryGetUri', json.statusQueryGetUri);",
              "pm.test('Orchestration started', () => {",
              "    pm.expect(json.instanceId).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/DocumentationStart",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"client-001\",\n  \"therapistName\": \"Dr. Jane Doe\",\n  \"sessionDate\": \"2026-06-02\",\n  \"discipline\": 0,\n  \"sessionDurationMinutes\": 45,\n  \"rawTranscript\": \"Therapist: How have you been feeling since our last session?\\nPatient: Honestly, not great. I've been having a lot of anxiety at work. My manager, Sarah Johnson, keeps piling on more projects and I feel like I can't keep up.\\nTherapist: That sounds really stressful. How is it affecting your sleep?\\nPatient: I've been waking up at 3am almost every night. My wife Emily has noticed too - she's worried about me.\\nTherapist: Are you having any physical symptoms?\\nPatient: Yeah, headaches mostly. And my chest gets tight when I think about going into the office.\\nTherapist: Let's talk about some coping strategies. Have you tried any of the breathing exercises we discussed?\\nPatient: I tried the box breathing once but I forgot how to do it properly.\\nTherapist: That's okay, we can practice that again today. I also want to suggest we try cognitive behavioral techniques to reframe some of the negative thoughts about work.\"\n}"
        }
      }
    },
    {
      "name": "2 - Poll for Completion",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('statusCode', json.runtimeStatus);",
              "pm.test('Status received', () => {",
              "    pm.expect(['Running', 'Completed', 'Failed']).to.include(json.runtimeStatus);",
              "});",
              "if (json.runtimeStatus === 'Completed') {",
              "    pm.test('SOAP note has Subjective', () => pm.expect(json.output.RestoredNote.Subjective).to.be.a('string'));",
              "    pm.test('SOAP note has Objective', () => pm.expect(json.output.RestoredNote.Objective).to.be.a('string'));",
              "    pm.test('SOAP note has Assessment', () => pm.expect(json.output.RestoredNote.Assessment).to.be.a('string'));",
              "    pm.test('SOAP note has Plan', () => pm.expect(json.output.RestoredNote.Plan).to.be.a('string'));",
              "    pm.test('CPT codes present', () => pm.expect(json.output.SuggestedCptCodes).to.be.an('array').that.is.not.empty);",
              "    pm.test('CPT codes have required fields', () => {",
              "        json.output.SuggestedCptCodes.forEach(c => {",
              "            pm.expect(c.Code).to.be.a('string');",
              "            pm.expect(c.Description).to.be.a('string');",
              "            pm.expect(c.Rationale).to.be.a('string');",
              "        });",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/runtime/webhooks/durabletask/instances/{{instanceId}}?code={{durableCode}}"
      }
    }
  ]
}